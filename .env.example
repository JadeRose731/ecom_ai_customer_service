# 聊天上游。CHAT_MODEL 要写上游认的真实模型名,没有别名这一层
CHAT_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_API_KEY=sk-xxx

TOKEN_BUDGET=2000

# 嵌入 BAAI/bge-m3。BASE_URL 有内置默认值(硅基流动),换上游才需要填
EMBED_API_KEY=sk-xxx
# EMBED_BASE_URL=https://api.siliconflow.cn/v1

# Milvus。默认 http://localhost:19530(docker compose 里的 standalone),Lite 本地文件换上游才需要填
# MILVUS_URI=http://localhost:19530

# 重排 BAAI/bge-reranker-v2-m3。BASE_URL 有内置默认值(硅基流动)
RERANK_API_KEY=sk-xxx
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

DATABASE_URL=mysql+asyncmy://root:root@localhost:3307/mewhelp
TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3307/mewhelp_test

# ch08 工具系统
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0
